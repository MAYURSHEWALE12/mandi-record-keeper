{
    "name": "trambkaraj/backend-php",
    "description": "Trambkaraj Traders - PHP Backend API",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "illuminate/database": "^11.0",
        "illuminate/events": "^11.0",
        "illuminate/pagination": "^11.0",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.0",
        "firebase/php-jwt": "^6.0",
        "vlucas/phpdotenv": "^5.0",
        "php-di/php-di": "^7.0",
        "php-di/slim-bridge": "^3.0",
        "symfony/mailer": "^7.0",
        "symfony/mime": "^7.0"
    },
    "config": {
        "allow-plugins": {
            "php-di/php-di": true,
            "php-http/discovery": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8000 -t public",
        "migrate": "php database/migrate.php",
        "seed": "php database/seed.php",
        "setup": "php database/migrate.php && php database/seed.php"
    }
}
